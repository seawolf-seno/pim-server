#!/bin/bash
# pim-dev: run a local pim server with the fictional school, as you (not root).
#
#   pim-dev up        seed .dev/ from fixtures/school, create accounts, start Prosody
#   pim-dev down      stop it
#   pim-dev status    is it running
#   pim-dev log       follow the log
#   pim-dev reset     stop and delete .dev/ (all dev accounts and messages)
#
# PIM_FAKE_NOW="2026-11-09 10:00" pim-dev up pins the class-time clock (Monday,
# Biology, in the fictional school), for testing and demos.
#
# Every fictional account's password is "pim-dev". Needs prosody
# (sudo pacman -S prosody); the system service is not used.
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
dev=$root/.dev
cfg=$dev/prosody.cfg.lua
host=pim.test
password=pim-dev

need_prosody() {
  command -v prosody >/dev/null && command -v prosodyctl >/dev/null || {
    echo "pim-dev: prosody isn't installed (sudo pacman -S prosody)" >&2
    exit 1
  }
}

running() {
  [[ -f $dev/prosody.pid ]] && kill -0 "$(cat "$dev/prosody.pid")" 2>/dev/null
}

ctl() { prosodyctl --config "$cfg" "$@"; }

seed() {
  mkdir -p "$dev/data" "$dev/certs"
  # A self-signed certificate for the dev domain. Clients trust this file only.
  if [[ ! -f $dev/certs/$host.crt ]]; then
    openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days 825 \
      -subj "/CN=$host" -addext "subjectAltName=DNS:$host,DNS:rooms.$host" \
      -addext "basicConstraints=critical,CA:TRUE" \
      -keyout "$dev/certs/$host.key" -out "$dev/certs/$host.crt" 2>/dev/null
    chmod 600 "$dev/certs/$host.key"
  fi
  chmod 700 "$dev"
  python3 -I "$root/bin/pim-seed" build \
    --school "$root/fixtures/school/school.toml" \
    --schedule "$root/fixtures/school/schedule.toml" \
    --out "$dev/seed"
  sed -e "s|@DEV@|$dev|g" -e "s|@MODULES@|$root/server/modules|g" \
    "$root/server/dev/prosody.cfg.lua.in" >"$cfg"
  if [[ -n ${PIM_FAKE_NOW:-} ]]; then
    [[ $PIM_FAKE_NOW =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}\ [0-9]{2}:[0-9]{2}$ ]] || {
      echo "pim-dev: PIM_FAKE_NOW must be \"YYYY-MM-DD HH:MM\"" >&2
      exit 1
    }
    # Global option, before the first VirtualHost line.
    sed -i "s|^VirtualHost |pim_classtime_fake_now = \"$PIM_FAKE_NOW\"\n\nVirtualHost |" "$cfg"
  fi
  # Prosody's internal storage keeps an account at data/<host, "." as %2e>/accounts/.
  local accounts=$dev/data/${host//./%2e}/accounts
  while read -r login; do
    [[ -n $login ]] || continue
    [[ -f $accounts/$login.dat ]] && continue
    ctl register "$login" "$host" "$password" >/dev/null 2>&1 || {
      echo "pim-dev: couldn't create $login@$host" >&2
      exit 1
    }
  done <"$dev/seed/accounts.txt"
}

case ${1:-} in
  up)
    need_prosody
    if running; then echo "Already running (pim-dev down first)."; exit 0; fi
    seed
    nohup prosody --config "$cfg" -F >>"$dev/prosody.out" 2>&1 &
    for _ in $(seq 50); do
      running && break
      sleep 0.1
    done
    if running; then
      echo "pim dev server on 127.0.0.1:5222 (TLS; trust $dev/certs/$host.crt), domain $host."
      echo "Accounts: fixtures/school/school.toml, password $password"
    else
      echo "Prosody didn't start; see $dev/prosody.out and $dev/prosody.err" >&2
      exit 1
    fi
    ;;
  down)
    if running; then kill "$(cat "$dev/prosody.pid")"; echo "Stopped."; else echo "Not running."; fi
    ;;
  status)
    if running; then echo "Running (pid $(cat "$dev/prosody.pid"))."; else echo "Not running."; exit 1; fi
    ;;
  log)
    exec tail -f "$dev/prosody.log" "$dev/prosody.err"
    ;;
  reset)
    if running; then kill "$(cat "$dev/prosody.pid")"; fi
    rm -rf "$dev"
    echo "Deleted .dev/."
    ;;
  *)
    sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
