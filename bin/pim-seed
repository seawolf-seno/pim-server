#!/usr/bin/env python3
"""pim-seed: turn a school file and a schedule into what the pim server reads.

    pim-seed build --school school.toml --schedule schedule.toml --out DIR [--real]

Writes into DIR:
  groups.txt    Prosody mod_groups file: one buddy-list group per class and
                activity (teacher or leader plus members), and "Teachers" for all staff.
  school.json   people, classes, activities and the schedule, for mod_pim_classtime.
  accounts.txt  one login per line, for creating accounts.

Fictional data only unless --real, and --real refuses to write inside a git
repository, so a real roster can't be committed by accident.
"""

import argparse
import json
import os
import re
import sys
import tomllib
from pathlib import Path

LOGIN_RE = re.compile(r"^[a-z_][a-z0-9_.-]{0,31}$")  # same as pacos-add-user
STUDENT_RE = re.compile(r"^[a-z]+[0-9]{2}$")  # same as pacos-role
ID_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,62}$")
TIME_RE = re.compile(r"^([01][0-9]|2[0-3]):[0-5][0-9]$")
DATE_RE = re.compile(r"^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
WEEKDAYS = ["Mon", "Tue", "Wed", "Thu", "Fri"]


class SeedError(Exception):
    pass


def role_of(login):
    return "student" if STUDENT_RE.match(login) else "staff"


def load_toml(path):
    try:
        with open(path, "rb") as f:
            return tomllib.load(f)
    except (OSError, tomllib.TOMLDecodeError) as e:
        raise SeedError(f"{path}: {e}") from e


def check_school(school, real):
    if not real and school.get("fictional") is not True:
        raise SeedError("school file is not marked `fictional = true`; use --real for real data")
    for key in ("domain", "rooms_domain"):
        if not isinstance(school.get(key), str) or not school[key]:
            raise SeedError(f"school file needs `{key}`")

    people = {}
    for p in school.get("person", []):
        login, name = p.get("login"), p.get("name")
        if not isinstance(login, str) or not LOGIN_RE.match(login):
            raise SeedError(f"not a valid login: {login!r}")
        if login in people:
            raise SeedError(f"login listed twice: {login}")
        if not isinstance(name, str) or not name.strip() or "\n" in name or "=" in name:
            raise SeedError(f"{login}: needs a one-line name without '='")
        people[login] = {"name": name.strip(), "role": role_of(login)}
    if not people:
        raise SeedError("school file lists no people")

    def need(login, role, where):
        if login not in people:
            raise SeedError(f"{where}: unknown login {login!r}")
        if role and people[login]["role"] != role:
            raise SeedError(f"{where}: {login} is not a {role}")

    ids = set()

    def check_id(i, where):
        if not isinstance(i, str) or not ID_RE.match(i):
            raise SeedError(f"{where}: not a valid id: {i!r}")
        if i in ids:
            raise SeedError(f"id used twice: {i}")
        ids.add(i)

    classes = []
    for c in school.get("class", []):
        check_id(c.get("id"), "class")
        where = f"class {c['id']}"
        if not isinstance(c.get("name"), str) or not c["name"].strip():
            raise SeedError(f"{where}: needs a name")
        if c.get("day") not in ("A", "B"):
            raise SeedError(f"{where}: day must be \"A\" or \"B\"")
        if not isinstance(c.get("block"), int) or c["block"] < 1:
            raise SeedError(f"{where}: block must be a whole number from 1")
        need(c.get("teacher"), "staff", where)
        students = c.get("students", [])
        for s in students:
            need(s, "student", where)
        classes.append({"id": c["id"], "name": c["name"].strip(), "day": c["day"],
                        "block": c["block"], "teacher": c["teacher"],
                        "students": sorted(set(students))})

    activities = []
    for a in school.get("activity", []):
        check_id(a.get("id"), "activity")
        where = f"activity {a['id']}"
        if not isinstance(a.get("name"), str) or not a["name"].strip():
            raise SeedError(f"{where}: needs a name")
        need(a.get("leader"), "staff", where)
        members = a.get("members", [])
        for m in members:
            need(m, "student", where)
        activities.append({"id": a["id"], "name": a["name"].strip(), "leader": a["leader"],
                           "members": sorted(set(members))})

    readers = school.get("archive_readers", [])
    for r in readers:
        need(r, "staff", "archive_readers")

    return {"domain": school["domain"], "rooms_domain": school["rooms_domain"],
            "people": people, "classes": classes, "activities": activities,
            "archive_readers": sorted(set(readers))}


def check_schedule(sched):
    def date(v, where):
        if not isinstance(v, str) or not DATE_RE.match(v):
            raise SeedError(f"schedule {where}: not a YYYY-MM-DD date: {v!r}")
        return v

    out = {"first_day": date(sched.get("first_day"), "first_day"),
           "last_day": date(sched.get("last_day"), "last_day")}
    for key in ("a_days", "b_days"):
        days = sched.get(key, [])
        for d in days:
            if d not in WEEKDAYS:
                raise SeedError(f"schedule {key}: not a weekday: {d!r}")
        out[key] = list(days)
    if set(out["a_days"]) & set(out["b_days"]):
        raise SeedError("schedule: a day is both an A day and a B day")

    blocks, numbers = [], set()
    for b in sched.get("blocks", []):
        n, start, end = b.get("number"), b.get("start"), b.get("end")
        if not isinstance(n, int) or n < 1 or n in numbers:
            raise SeedError(f"schedule block: bad or repeated number {n!r}")
        for t in (start, end):
            if not isinstance(t, str) or not TIME_RE.match(t):
                raise SeedError(f"schedule block {n}: not an HH:MM time: {t!r}")
        if start >= end:
            raise SeedError(f"schedule block {n}: starts after it ends")
        numbers.add(n)
        blocks.append({"number": n, "start": start, "end": end})
    if not blocks:
        raise SeedError("schedule lists no blocks")
    out["blocks"] = sorted(blocks, key=lambda b: b["start"])

    fridays = {}
    for d, t in sched.get("fridays", {}).items():
        if t not in ("A", "B"):
            raise SeedError(f"schedule fridays {d}: must be \"A\" or \"B\"")
        fridays[date(d, "fridays")] = t
    out["fridays"] = fridays

    off = []
    for o in sched.get("off", []):
        f, t = date(o.get("from"), "off from"), date(o.get("to"), "off to")
        if f > t:
            raise SeedError(f"schedule off {f}: ends before it starts")
        off.append({"from": f, "to": t, "label": str(o.get("label", ""))})
    out["off"] = off
    return out


def groups_file(school):
    people, domain = school["people"], school["domain"]

    def section(title, logins):
        lines = [f"[{title}]"]
        lines += [f"{l}@{domain}={people[l]['name']}" for l in logins]
        return "\n".join(lines)

    sections = []
    for c in school["classes"]:
        sections.append(section(c["name"], [c["teacher"], *c["students"]]))
    for a in school["activities"]:
        sections.append(section(a["name"], [a["leader"], *a["members"]]))
    staff = sorted(l for l, p in people.items() if p["role"] == "staff")
    sections.append(section("Teachers", staff))
    return "\n\n".join(sections) + "\n"


def inside_git_repo(path):
    p = path.resolve()
    for d in (p, *p.parents):
        if (d / ".git").exists():
            return True
    return False


def build(args):
    school = check_school(load_toml(args.school), args.real)
    school["schedule"] = check_schedule(load_toml(args.schedule))
    out = Path(args.out)
    if args.real and inside_git_repo(out):
        raise SeedError(f"{out} is inside a git repository: real school data never goes in one")
    out.mkdir(parents=True, exist_ok=True)
    os.chmod(out, 0o700)
    files = {
        "groups.txt": groups_file(school),
        "school.json": json.dumps(school, indent=2, ensure_ascii=False) + "\n",
        "accounts.txt": "".join(f"{l}\n" for l in sorted(school["people"])),
    }
    for name, text in files.items():
        path = out / name
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
    # Counts only: never print names.
    print(f"{len(school['people'])} people, {len(school['classes'])} classes, "
          f"{len(school['activities'])} activities -> {out}")


def main(argv=None):
    parser = argparse.ArgumentParser(prog="pim-seed", description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="cmd", required=True)
    b = sub.add_parser("build", help="check the school and schedule files and write the server's files")
    b.add_argument("--school", required=True)
    b.add_argument("--schedule", required=True)
    b.add_argument("--out", required=True)
    b.add_argument("--real", action="store_true", help="allow a school file not marked fictional")
    args = parser.parse_args(argv)
    try:
        build(args)
    except SeedError as e:
        print(f"pim-seed: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
